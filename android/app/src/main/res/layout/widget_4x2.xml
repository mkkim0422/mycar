<?xml version="1.0" encoding="utf-8"?>
<!--
    4×2 위젯 레이아웃 — 가로로 긴 풀블리드 사진 + 구역 + 주차시각 + 경과시간
    ┌─────────────────────────────────────────┐
    │  [사                 진]                │
    │▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓│ ← 하단 그라디언트 쉐도우
    │  지하 2층 · 22구역                      │ ← 구역 (28sp/w900)
    │  오후 3:22 주차 · 1시간 12분 경과        │ ← 주차시각 + 경과시간
    └─────────────────────────────────────────┘
    사진 없을 때: Toss Blue 배경 + 아이콘 + 안내 문구.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0064FF">

    <!-- ── 배경 사진 (데이터 + 사진 있을 때) ──────────────────────────────── -->
    <ImageView
        android:id="@+id/iv_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- ── 빈 상태: 아이콘 + 안내 문구 ───────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="📍"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tv_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="탭하여 주차 기록"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── 하단 쉐도우 오버레이 ─────────────────────────────────────────── -->
    <!-- RemoteViews 기본 지원 뷰가 아닌 <View> 대신 ImageView 사용 (인플레이션 안정성) -->
    <ImageView
        android:id="@+id/view_shadow"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_shadow_gradient"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- ── 데이터 상태: 구역 + 시각 + 주소 (우측 하단 정렬) ──────────────── -->
    <!-- 사진 위 풀스크린 어두운 오버레이는 제거됨. 텍스트 가독성은 하단 gradient -->
    <!-- shadow (view_shadow) + 개별 text shadow 만으로 확보한다. -->
    <LinearLayout
        android:id="@+id/ll_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:letterSpacing="-0.01"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:alpha="0.70"
            android:ellipsize="end"
            android:letterSpacing="-0.01"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
