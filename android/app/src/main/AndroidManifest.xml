<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── 카메라 ─────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ── 저장소 (사진 저장, Android 12 이하) ──────────────────────────── -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ── Bluetooth (수동 Broadcast 방식, 지속 스캔 없음) ─────────────── -->
    <!-- API 30 이하: 기본 Bluetooth 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- API 31+: 연결된 기기 정보 접근 권한 (ACL_DISCONNECTED 인텐트 수신에 필요) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ── 푸시 알림 (Android 13+ 런타임 권한) ──────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── 포그라운드 서비스 (모션 감지용, BT 해제 후 가속도계 모니터링) ── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />

    <!-- ── 위치 (주차 지점 GPS 좌표 저장 → 네이버 지도 연동용) ─────────── -->
    <!-- foreground 전용: 촬영 시점에만 1회 조회. background 권한 불필요. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ── 인터넷 (역지오코딩 HTTPS 호출: OpenStreetMap Nominatim) ──────── -->
    <!-- release 빌드는 debug 매니페스트 자동 머지가 적용되지 않으므로 명시 필수. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ── 하드웨어 기능 선언 ─────────────────────────────────────────────── -->
    <!-- 카메라: 핵심 기능 — 없으면 앱 설치 불가 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <!-- 블루투스: 선택적 기능 — 없어도 설치 가능 (카메라만으로 사용 가능) -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:label="주차기억"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false">

        <!-- ── 메인 액티비티 ─────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ── BluetoothDisconnectReceiver ─────────────────────────────────
            Bluetooth 연결 해제 시 OS가 자동으로 브로드캐스트를 전달한다.
            • exported=true  : 시스템(OS)이 외부에서 인텐트를 전달하기 위해 필요
            • android:permission : BLUETOOTH_CONNECT 권한 보유 주체만 브로드캐스트 전달 가능
            • 지속적인 BT 스캔 없이 OS 이벤트에만 수동적으로 반응 → 배터리 광탈 없음
        -->
        <receiver
            android:name=".core.receiver.BluetoothDisconnectReceiver"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!--
            ── MotionDetectionService ─────────────────────────────────────
            BT 연결 해제 후 가속도계 기반 하차 모션을 감지하는 경량 포그라운드 서비스.
            shortService(Android 14+): 3분 제한, 빠르게 종료되면 알림 미노출.
            BT 브로드캐스트에서 시작 → Android 12+ 백그라운드 제한 면제 대상.
        -->
        <service
            android:name=".core.service.MotionDetectionService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!--
            ── ParkingWidget2x1Provider ────────────────────────────────────
            2×1 미니멀 위젯 (Toss Blue + 구역 텍스트).
        -->
        <receiver
            android:name=".core.widget.ParkingWidget2x1Provider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_info_2x1" />
        </receiver>

        <!--
            ── ParkingWidget2x2Provider ────────────────────────────────────
            2×2 정사각형 풀블리드 사진 위젯.
        -->
        <receiver
            android:name=".core.widget.ParkingWidget2x2Provider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_info_2x2" />
        </receiver>

        <!--
            ── ParkingWidget4x2Provider ────────────────────────────────────
            4×2 가로형 위젯 — 풀블리드 사진 + 구역 + 주차시각 + 경과시간.
        -->
        <receiver
            android:name=".core.widget.ParkingWidget4x2Provider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_info_4x2" />
        </receiver>

        <!--
            ── ParkingWidget4x4Provider ────────────────────────────────────
            4×4 대형 풀블리드 사진 + 구역 + 시간 위젯.
        -->
        <receiver
            android:name=".core.widget.ParkingWidget4x4Provider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_info_4x4" />
        </receiver>

        <!--
            ── AdMob 앱 ID ─────────────────────────────────────────────────
            buildType 별 주입 (debug=테스트, release=실제).
            값은 android/app/build.gradle.kts 의 manifestPlaceholders 단일소스에서
            파생되므로 여기 하드코딩 금지.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!--
            ── ML Kit OCR 모델 자동 다운로드 ────────────────────────────────
            google_mlkit_text_recognition (Korean script) 가 처음 호출될 때
            Google Play Services 가 Korean OCR 모델을 백그라운드로 다운로드한다.
            이 메타데이터가 누락되면 첫 호출 시 모델 부재로 인식 실패.
            (네이티브 라이브러리 `text-recognition-korean:16.0.1` 는 app/build.gradle.kts
            에 이미 명시되어 있어 클래스 로딩은 보장된다.)
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr_korean" />

        <!-- Flutter 임베딩 버전 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Android 11+ 쿼리 선언 (카메라 인텐트 가시성, 카카오톡 공유, 네이버 지도) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- 카카오톡 공유: isKakaoTalkSharingAvailable() 호출 시 필요 -->
        <package android:name="com.kakao.talk" />
        <!-- 네이버 지도: nmap:// URL 스킴 canLaunchUrl 판별에 필요 -->
        <package android:name="com.nhn.android.nmap" />
        <!-- url_launcher 가 웹 폴백(https) 가시성을 확인하기 위한 뷰 인텐트 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- 피드백 "의견보내기": mailto 메일 앱 가시성 (Android 11+) -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
